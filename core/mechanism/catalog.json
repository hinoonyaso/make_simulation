    "mppi": {"domain": "robotics", "support_level": "L2", "implementation_status": "pilot_replay_only", "trace_schema": "robotics-visual-trace/v1", "renderers": ["manim", "blender"], "known_limitations": ["Existing topic material only; no general Nav2 MPPI execution adapter."]},
