  "overrides": {
    "rag": {
      "domain": "ai_deep_learning", "support_level": "L3", "implementation_status": "ready",
      "adapter": "core.mechanism.adapters.rag:RAGAdapter", "execution_backend": "local TF-IDF/cosine or saved trace",
      "trace_schema": "ai-mechanism-trace/v1", "renderers": ["manim", "threejs"],
      "software_requirements": ["Python 3.12", "Manim", "optional Node/Playwright/Chromium"],
      "known_limitations": ["Fresh execution is lexical only; no semantic embedding model or answer LLM.", "Default production is a silent technical render; narration/reviewer evidence is not automatically completed by the CLI."]
    },
    "quantization": {
      "domain": "ai_deep_learning", "support_level": "L3", "implementation_status": "ready",
      "adapter": "core.mechanism.adapters.quantization:QuantizationAdapter", "execution_backend": "NumPy",
      "trace_schema": "mechanism-envelope/v1", "renderers": ["manim"],
      "supported_features": ["weight-only", "weight+activation", "symmetric/asymmetric", "per-tensor/per-channel", "INT8/INT4", "dequantization/error"],
      "software_requirements": ["Python 3.12", "NumPy"],
      "known_limitations": ["Reference arithmetic simulation only; no accelerator kernel or model-quality benchmark."]
    },
    "nms": {
      "domain": "computer_vision", "support_level": "L3", "implementation_status": "ready",
      "adapter": "core.mechanism.adapters.nms:NMSAdapter", "execution_backend": "NumPy",
      "trace_schema": "mechanism-envelope/v1", "renderers": ["manim"],
      "supported_features": ["confidence filtering", "IoU", "greedy NMS"],
      "software_requirements": ["Python 3.12", "NumPy"],
      "known_limitations": ["Synthetic candidates; no YOLO model inference, image preprocessing, or dataset accuracy claim."]
    },
    "mcu_pid": {
      "domain": "mcu_embedded", "support_level": "L3", "implementation_status": "ready",
      "adapter": "core.mechanism.adapters.mcu_pid:MCUPIDAdapter", "execution_backend": "deterministic discrete-time motor model",
      "trace_schema": "mechanism-envelope/v1", "renderers": ["manim"],
      "supported_features": ["sampled PID", "PWM saturation", "first-order motor response", "encoder feedback"],
      "known_limitations": ["Numerical toy plant only; no firmware, peripheral simulator, or physical board measurement."]
    },
    "robot_kinematics": {
      "domain": "robotics", "support_level": "L3", "implementation_status": "ready",
      "adapter": "core.mechanism.adapters.mujoco_arm:MuJoCoArmAdapter", "execution_backend": "MuJoCo 3.7.0",
      "trace_schema": "robotics-visual-trace/v1", "renderers": ["manim"],
      "asset_requirements": ["blender.unitree_h1.v1"], "software_requirements": ["Python 3.12", "MuJoCo 3.7.0"],
      "hardware_requirements": [], "benchmark_requirements": ["fixed-base H1 model, timestep, controller settings"],
